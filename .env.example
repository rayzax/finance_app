# Local development settings. Copy to .env (never commit .env).
# Use single quotes around values containing $ (such as a bcrypt hash).

NODE_ENV=development
PORT=8080

# Plaid sandbox keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# Session signing key (any long random string): openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# bcrypt hash of your password: cd server && npm run hash-password
# Bootstrap only: while no user exists, signing in as BOOTSTRAP_ADMIN_USERNAME with this password creates the first
# admin and starts TOTP enrollment. Once any user exists this value is ignored for login.
APP_PASSWORD_HASH='replace-with-bcrypt-hash'
BOOTSTRAP_ADMIN_USERNAME=drew
BOOTSTRAP_ADMIN_NAME=Drew

# Firestore emulator (started by scripts/dev.sh; needs Java 21+)
GOOGLE_CLOUD_PROJECT=reserve-dev
FIRESTORE_DATABASE=finance
FIRESTORE_EMULATOR_HOST=localhost:8081

# Token encryption. Leave KMS_KEY_NAME unset locally so the server uses AES-256-GCM
# with DEV_ENCRYPTION_KEY (64 hex chars). Generate one with: openssl rand -hex 32
# KMS_KEY_NAME=projects/<project>/locations/<region>/keyRings/reserve/cryptoKeys/plaid-tokens
DEV_ENCRYPTION_KEY=replace-with-64-hex-chars

APP_TIMEZONE=America/Denver

# Public base URL; leave unset locally to skip the Plaid webhook.
# PUBLIC_URL=http://localhost:5173
# Production only (set by Terraform):
# RUN_SERVICE_URL=https://reserve-<project-number>.us-central1.run.app
# SCHEDULER_SA_EMAIL=reserve-scheduler@<project>.iam.gserviceaccount.com
# STATIC_DIR=/app/public
